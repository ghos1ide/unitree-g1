[Unit]
Description=ELN V1.5 HTTP interface service on port 8090
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/rh56dfx/workspace/communication/eln_http_demo
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/default/rh56dfx-eln-interface
ExecStart=/home/unitree/.miniconda3/envs/Unitree/bin/python -m deployment.interface_service --host 0.0.0.0 --port 8090
Restart=always
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
